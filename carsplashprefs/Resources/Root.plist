			<string>Xoá video đang chọn</string>
			<key>action</key>
			<string>deleteVideo</string>
			<key>isDestructive</key>
			<true/>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Thời lượng (giây)</string>
