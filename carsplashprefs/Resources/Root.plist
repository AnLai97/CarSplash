			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.carsplash</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
