			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.anlai.carsplash</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Chạm để bỏ qua</string>
			<key>key</key>
			<string>tapToSkip</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.carsplash</string>
		</dict>
	</array>
</dict>
</plist>
